# Only needed to have Claude write new scenarios: npm run scenarios -- --claude
# Copy this file to .env.local (it is git-ignored) and paste your key. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default) or claude-sonnet-5-5
SCENARIO_MODEL=claude-opus-5-5

# Optional: where player feedback is saved (the Neon connection string). On Vercel, connecting a Neon database sets this for you.
# Read it back with: npm run feedback
DATABASE_URL=

# The key for the developer numbers page (/dev.html). Make one with: openssl rand -hex 16
ADMIN_TOKEN=
